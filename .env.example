# انسخ هذا الملف إلى .env وعدّل القيم
PORT=3000

# رمز الدخول للوحة الإدارة — اختر قيمة طويلة وعشوائية
ADMIN_TOKEN=change-me-to-a-long-random-string

# مسار ملف قاعدة البيانات (الافتراضي data/aluminum.db)
# DB_FILE=./data/aluminum.db

# اضبطها على 1 إذا كان الخادم خلف Nginx / Cloudflare
# TRUST_PROXY=1

# ---- WhatsApp Cloud API (من developers.facebook.com) ----
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# كلمة تختارها أنت وتضعها نفسها في لوحة Meta عند إضافة رابط الـ Webhook
# WHATSAPP_VERIFY_TOKEN=
# App Secret للتحقق من توقيع الرسائل الواردة (موصى به)
# WHATSAPP_APP_SECRET=
# رقم الإدارة الذي يستلم تنبيه كل طلب عرض سعر جديد
# WHATSAPP_NOTIFY_TO=9689XXXXXXX
# WHATSAPP_API_VERSION=v21.0

# ---- المساعد الذكي (Claude API) — يرد على عملاء واتساب ويحسب أسعار أبواب الرول شتر ----
# المفتاح من https://platform.claude.com
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5
# low | medium | high — مستوى التفكير (medium مناسب للمحادثات)
# AGENT_EFFORT=medium

# ---- التضمين في موقع آخر ----
# المواقع المسموح لها بتضمين حاسبة العميل في <iframe> (مفصولة بمسافة). لوحة الإدارة لا يمكن تضمينها أبداً.
# EMBED_ALLOWED_ORIGINS=https://radma.co https://www.radma.co https://calcoverhead.radma.co

# ---- MazBot: قالب واتساب لأرقام المبيعات عند «احتساب السعر» (نفس حاسبات موقع ردما) ----
# لا تضع هذه القيم في Git أبداً — تُضاف في متغيرات البيئة على الخادم فقط
# MAZBOT_API_KEY=
# حساب موظف (client-staff) — حساب المالك لا يعمل مع API
# MAZBOT_STAFF_EMAIL=
# MAZBOT_STAFF_PASSWORD=
# رقم قالب الرولينج شتر (11 متغيراً) من لوحة MazBot
# MAZBOT_TEMPLATE_ID=
# رقم قالب الأوفرهيد (8 متغيرات)
# MAZBOT_OVERHEAD_TEMPLATE_ID=
# MAZBOT_BASE_URL=https://mazbot.net/api
# 1 = وضع تجريبي: لا يتصل بـ MazBot فعلياً
# MAZBOT_DRY_RUN=0
# أرقام الاستقبال تُعدّل من لوحة الإدارة (تبويب الربط)، الافتراضي 76979066 و 90660001
